TURNOS_DB_PASSWORD=

# Claves externas PEM: privada PKCS#8 y publica X.509; RSA minimo 2048 bits.
# No guardar claves privadas en el repositorio ni regenerarlas en cada arranque.
TURNOS_JWT_PRIVATE_KEY_LOCATION=file:/ruta/externa/turnos-private.pem
TURNOS_JWT_PUBLIC_KEY_LOCATION=file:/ruta/externa/turnos-public.pem

# Cliente REST de Catalogo
# Sin definir CATALOGO_BASE_URL se usa el valor predeterminado de cada modo:
# Docker Compose: http://svc-catalogo:8080; Java en Ubuntu: http://localhost:8081.
# Para sobrescribirlo, descomentar solo la alternativa correspondiente:
# CATALOGO_BASE_URL=http://svc-catalogo:8080
# CATALOGO_BASE_URL=http://localhost:8081
CATALOGO_CONNECT_TIMEOUT=3s
CATALOGO_RESPONSE_TIMEOUT=5s

# Docker: rutas absolutas de archivos existentes, sin prefijo file:.
# Nunca guardar claves reales en el repositorio ni usar la privada en Catalogo.
TURNOS_JWT_PRIVATE_KEY_FILE=
TURNOS_JWT_PUBLIC_KEY_FILE=
# UID/GID no root con permiso para leer la privada. Para una clave 0600 del usuario
# local, completar con los resultados de id -u e id -g (ver README).
TURNOS_CONTAINER_UID=10001
TURNOS_CONTAINER_GID=10001
TURNOS_HTTP_PORT=8080
TURNOS_DB_PORT=5433

# En Docker, CATALOGO_BASE_URL debe ser una URL alcanzable desde el contenedor;
# localhost apunta al propio Turnos, no a Ubuntu ni a Catalogo. Ver README.

# Integracion tecnica con catedra, independiente del JWT de los usuarios.
CATEDRA_BASE_URL=
CATEDRA_TECHNICAL_TOKEN=
CATEDRA_CONNECT_TIMEOUT=3s
CATEDRA_RESPONSE_TIMEOUT=5s
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_GROUP_ID=
KAFKA_APPOINTMENT_ACTIONS_TOPIC=
KAFKA_LISTENER_AUTO_STARTUP=false
CATEDRA_GROUP_ID=
KAFKA_APPOINTMENT_PHONE_TOPIC=
KAFKA_PHONE_PUBLICATION_ENABLED=false
