TURNOS_DB_PASSWORD=

# Claves externas PEM: privada PKCS#8 y publica X.509; RSA minimo 2048 bits.
# No guardar claves privadas en el repositorio ni regenerarlas en cada arranque.
TURNOS_JWT_PRIVATE_KEY_LOCATION=file:/ruta/externa/turnos-private.pem
TURNOS_JWT_PUBLIC_KEY_LOCATION=file:/ruta/externa/turnos-public.pem
